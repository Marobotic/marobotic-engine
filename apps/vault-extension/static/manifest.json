{
  "manifest_version": 3,
  "name": "Vault",
  "version": "0.3.7",
  "description": "Vault in your browser: fills logins and 2FA codes, saves new logins and passkeys, signs in with passkeys, suggests strong passwords. Syncs with your marobotic account.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/32.png",
    "32": "icons/32.png",
    "48": "icons/128.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vault",
    "default_icon": {
      "16": "icons/32.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "privacy",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Fill the best login (or the 2FA code) on this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
