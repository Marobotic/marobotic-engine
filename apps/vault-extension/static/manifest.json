{
  "manifest_version": 3,
  "name": "Vault",
  "version": "0.2.0",
  "description": "Fills your logins and 2FA codes from the Vault app, saves new logins as you sign in, and suggests strong passwords.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/128.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Vault", "default_icon": { "16": "icons/32.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "privacy"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "commands": {
    "fill-login": { "suggested_key": { "default": "Ctrl+Shift+L" }, "description": "Fill the best login (or the 2FA code) on this page" }
  }
}
