{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Letterbox",
  "version": "0.1.2",
  "identifier": "dev.marobotic.letterbox",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Letterbox",
        "width": 1120,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#121212",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Marobotic",
    "shortDescription": "Your mail, on every device",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
