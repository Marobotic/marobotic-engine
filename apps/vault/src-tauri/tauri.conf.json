{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "0.1.4",
  "identifier": "dev.marobotic.vault",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vault",
        "width": 860,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://marobotic.dev; font-src 'self'; connect-src ipc: http://ipc.localhost https://marobotic.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Marobotic",
    "shortDescription": "Encrypted 2FA, passwords and passkeys",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
