// ------------------------------------------------------------------ the vault: passwords and 2FA codes
type TotpRow = Item & { data: TotpItem };
type LoginRow = Item & { data: LoginItem };
type Filter = "all" | "login" | "totp";

const otps = () => (vault?.list("totp") ?? []) as TotpRow[];
const logins = () => (vault?.list("login") ?? []) as LoginRow[];
const groupCode = (c: string) => (c.length === 6 ? `${c.slice(0, 3)} ${c.slice(3)}` : c.length === 8 ? `${c.slice(0, 4)} ${c.slice(4)}` : c);
const nameOf = (i: TotpRow) => i.data.label || i.data.otp.issuer || i.data.otp.account || "Untitled";
let filter: Filter = (localStorage.getItem("vault.filter") as Filter) || "all";

/** The 2FA code shown inside a login: the one it links to, if it still exists. */
const codeFor = (l: LoginRow) => (l.data.totpId ? (vault!.get(l.data.totpId) as TotpRow | undefined) : undefined);

let clearTimer = 0;
async function copySecret(text: string, what: string) {
  await navigator.clipboard.writeText(text);
  toast(`${what} copied - cleared from the clipboard in 30 s`);
  clearTimeout(clearTimer);
  clearTimer = window.setTimeout(async () => {
    try { if ((await navigator.clipboard.readText()) === text) await navigator.clipboard.writeText(""); } catch { /* can't read it: leave it */ }
  }, 30_000);
}

function homeScreen() {
  app.replaceChildren(h(`
