      <button class="m-btn subtle compact" id="kit" title="Make a new recovery kit; the old one stops working"> Recovery kit</button>
    </div>
    <div class="m-sync sync-line" id="sync" style="--state: var(--faint)">${session ? "Syncing…" : "Offline - saved on this PC"}</div>
    <div class="bar">
      <input class="m-field search" id="q" placeholder="Search passwords and codes" value="${esc(query)}">
      <div class="m-seg" id="filter">
        <button data-f="all">All</button><button data-f="login">Passwords</button><button data-f="totp">2FA codes</button>
      </div>
    </div>
    <div id="list"></div>`));
